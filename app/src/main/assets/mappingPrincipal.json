{
  "frases": [
    { "text": "tema 1: mi rutina diaria", "glosses": ["TEMA", "UNO", "MI", "RUTINA", "DIARIO"] },
    { "text": "subtema: los días y mis actividades", "glosses": ["SUBTEMA", "DIAS", "MIS", "ACTIVIDADES"] },
    { "text": "cada día es una oportunidad para aprender cosas nuevas", "glosses": ["CADA", "DIA", "OPORTUNIDAD", "APRENDER", "COSAS", "NUEVAS"] },
    { "text": "la semana tiene siete días: lunes, martes, miércoles, jueves, viernes, sábado y domingo", "glosses": ["SEMANA", "TIENE", "SIETE", "DIAS", "LUNES", "MARTES", "MIERCOLES", "JUEVES", "VIERNES", "SABADO", "DOMINGO"] },
    { "text": "hoy es un gran día para jugar y hacer la tarea", "glosses": ["HOY", "GRAN", "DIA", "JUGAR", "HACER", "TAREA"] },
    { "text": "ayer fuimos a pasear en bicicleta y mañana nos toca ir a la escuela", "glosses": ["AYER", "PASEAR", "BICICLETA", "MAÑANA", "IR", "ESCUELA"] },
    { "text": "en la mañana siempre usamos los zapatos y saludamos diciendo hola y buenos días", "glosses": ["MAÑANA", "SIEMPRE", "USAR", "ZAPATOS", "SALUDAR", "DECIR", "HOLA", "BUENOS_DIAS"] },
    { "text": "en la noche, cuando nos sentimos un poco cansado", "glosses": ["NOCHE", "SENTIR", "POCO", "CANSADO"] },
    { "text": "es momento de descansar en la cama y dormir muy feliz", "glosses": ["MOMENTO", "DESCANSAR", "CAMA", "DORMIR", "MUY", "FELIZ"] },
    { "text": "tema 2: la vida en la granja", "glosses": ["TEMA", "DOS", "VIDA", "GRANJA"] },
    { "text": "subtema: conociendo a los animales y sus amigos", "glosses": ["SUBTEMA", "CONOCER", "ANIMALES", "AMIGOS"] },
    { "text": "los animales de la granja son muy especiales y viven en un lugar muy bonito", "glosses": ["ANIMALES", "GRANJA", "MUY", "ESPECIALES", "VIVIR", "LUGAR", "BONITO"] },
    { "text": "a la vaca le gusta mucho comer pasto y nos da leche para hacer queso", "glosses": ["VACA", "GUSTAR", "MUCHO", "COMER", "PASTO", "DAR", "LECHE", "HACER", "QUESO"] },
    { "text": "el cerdo es gordo y muy chistoso, le encanta estar en su corral", "glosses": ["CERDO", "GORDO", "MUY", "CHISTOSO", "GUSTAR", "ESTAR", "CORRAL"] },
    { "text": "la oveja tiene lana de color blanco que es muy suave", "glosses": ["OVEJA", "TIENE", "LANA", "COLOR", "BLANCO", "MUY", "SUAVE"] },
    { "text": "y el burro es muy fuerte y ayuda a cargar cosas en el campo", "glosses": ["BURRO", "MUY", "FUERTE", "AYUDAR", "CARGAR", "COSAS", "CAMPO"] },
    { "text": "el gallo y la gallina caminan buscando comida y nos regalan huevos cada mañana", "glosses": ["GALLO", "GALLINA", "CAMINAR", "BUSCAR", "COMIDA", "REGALAR", "HUEVOS", "CADA", "MAÑANA"] },
    { "text": "un niño y su familia cuidan a los animales todos los días", "glosses": ["NIÑO", "FAMILIA", "CUIDAR", "ANIMALES", "TODOS", "DIAS"] },
    { "text": "con mucho amor, les dan agua limpia y comida", "glosses": ["MUCHO", "AMOR", "DAR", "AGUA", "LIMPIA", "COMIDA"] },
    { "text": "los animales se ponen muy feliz cuando las personas los ayudan", "glosses": ["ANIMALES", "PONER", "MUY", "FELIZ", "CUANDO", "PERSONAS", "AYUDAR"] },
    { "text": "si visitas una granja, siempre recuerda decir por favor y gracias", "glosses": ["VISITAR", "GRANJA", "SIPRE", "RECUERDA", "DECIR", "POR_FAVOR", "GRACIAS"] },
    { "text": "a las personas que trabajan ahí cuidando la naturaleza", "glosses": ["PERSONAS", "TRABAJAR", "AHI", "CUIDAR", "NATURALEZA"] }
  ],
