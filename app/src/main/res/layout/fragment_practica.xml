<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:animation="@anim/fade_in"
    tools:context=".ui.main.combo.principal.contenido.practica.PracticaFragment">

    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="80dp"
        android:background="@drawable/bg_card_elevated"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_subtema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Ejercicios del Subtema:"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorTertiary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Ejercicios Disponibles"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorTertiary"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/listViewEjercicios"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="14dp"
            android:paddingHorizontal="15dp"
            android:paddingVertical="20dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_volver"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Volver"
        android:text="Volver"
        android:textAllCaps="false"
        android:elevation="4dp"
        app:backgroundTint="?attr/colorSecondary"
        app:cornerRadius="12dp" />

</FrameLayout>