<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_marginVertical="100dp"
    android:paddingHorizontal="25dp" 
    android:background="@drawable/bg_esquinas_redondeadas_fondo"
    android:backgroundTint="@color/bg_azul"
    tools:context=".ui.main.combo.principal.materias.contenido.practica.EjercicioFragment">

    <LinearLayout
        android:id="@+id/layout_quiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start">

        <TextView
            android:id="@+id/tv_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="24dp" />

        <RadioGroup
            android:id="@+id/rg_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verificar"
            android:textColor="@color/white"
            android:backgroundTint="@color/acento"
            android:layout_gravity="center_horizontal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_resultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_resultado_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Has terminado!"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_puntaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_porcentaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn_volver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volver a ejercicios"
            android:backgroundTint="#4CAF50"
            android:textColor="@color/white" />

        <LinearLayout
            android:id="@+id/layout_retroalimentacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="15dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Deseas navegar a la teoría para revisar tus preguntas erroneas?"
                android:textSize="18sp"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/btn_retroalimentacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Revisar Teoría"
                android:backgroundTint="#4CAF50"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>