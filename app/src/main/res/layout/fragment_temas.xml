<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:orientation="vertical"
    tools:context=".ui.main.combo.principal.tema.TemasFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_esquinas_redondeadas_fondo"
        android:backgroundTint="?attr/colorSurface"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:id="@+id/tvNombreMateria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Materia: ''Algúna Materia''"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorTertiary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Temas Disponibles:"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorTertiary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Desliza para explorar más temas"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorTertiary" />


        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerTemas"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="36dp"
            android:paddingEnd="40dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_prev_tema"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:contentDescription="Tema anterior"
                android:src="@drawable/ic_arrow_back"
                app:backgroundTint="@color/colorAccent"
                app:fabSize="mini"
                app:tint="@android:color/white" />

            <LinearLayout
                android:id="@+id/indicadores_container_temas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_next_tema"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:contentDescription="Tema siguiente"
                android:src="@drawable/ic_arrow_forward"
                app:backgroundTint="@color/colorAccent"
                app:fabSize="mini"
                app:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_volver"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="10dp"
        android:contentDescription="Volver"
        android:text="Volver"
        android:textAllCaps="false"
        app:backgroundTint="?attr/colorSecondary"
        app:cornerRadius="10dp" />
</LinearLayout>