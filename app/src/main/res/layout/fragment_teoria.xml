<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container_teoria"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    tools:context=".ui.main.combo.principal.contenido.teoria.TeoriaFragment">

    <ScrollView
        android:id="@+id/scroll_teoria"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_esquinas_redondeadas_fondo_teoria"
            android:backgroundTint="?attr/colorSurface"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:id="@+id/tv_titulo_subtema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Nombre Subtema"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="?attr/colorTertiary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_contenido_teoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="5dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Mucho texto"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_volver"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:text="Volver"
        android:contentDescription="Volver"
        app:cornerRadius="10dp"
        app:backgroundTint="?attr/colorSecondary"
        android:textAllCaps="false" />

</FrameLayout>