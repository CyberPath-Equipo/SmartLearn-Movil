<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="5dp">
    <LinearLayout
        android:id="@+id/container_item_estandar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_item_menu"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/img_menu_icono"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:tint="@android:color/white"
            android:contentDescription="Icono del menú" />

        <TextView
            android:id="@+id/tv_menu_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>