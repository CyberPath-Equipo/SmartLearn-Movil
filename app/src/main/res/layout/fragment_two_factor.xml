<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animation="@anim/fade_in"
    android:background="@drawable/bg_gradient_header"
    android:clipChildren="false"
    android:padding="25dp"
    tools:context=".ui.acceso.TwoFactorFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="25dp"
        android:src="@drawable/img_logo_principal_texto" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="180dp"
        android:animation="@anim/slide_up"
        android:background="@drawable/bg_card_elevated"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_two_factor_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/two_factor_title"
            android:textColor="@color/colorOnSurface"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_two_factor_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/two_factor_totp_subtitle"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_two_factor_setup_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/two_factor_setup_help"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_two_factor_provisioning_uri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:hint="@string/two_factor_code_hint"
            app:boxStrokeColor="@color/colorOnSurface"
            app:hintTextColor="@color/colorOnSurface"
            app:startIconTint="@color/colorOnSurface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_two_factor_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="oneTimeCode"
                android:importantForAutofill="yes"
                android:inputType="number"
                android:maxLength="12"
                android:textColor="@color/colorOnSurface"
                android:textSize="18sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/cb_remember_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/two_factor_remember_device"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_verify_code"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="10dp"
            android:elevation="8dp"
            android:text="@string/two_factor_verify_button"
            android:textColor="@color/colorSurfaceBackward"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/colorSecondary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/white"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_resend_code"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/two_factor_resend_button"
            android:visibility="gone"
            app:cornerRadius="12dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="125dp"
        android:elevation="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:background="@drawable/bg_redondo_blanco"
            android:padding="4dp"
            android:src="@drawable/img_logo_empresa_redondo" />

        <ImageView
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginStart="-22dp"
            android:background="@drawable/bg_redondo_blanco"
            android:padding="4dp"
            android:src="@drawable/img_logo_sl_redondo" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:alpha="0.75"
        android:text="Desarrollado por CyberPath S.A. de C.V."
        android:textColor="?attr/colorOnPrimary"
        android:textSize="15sp" />

</FrameLayout>

