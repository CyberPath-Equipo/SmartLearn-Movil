<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_esquinas_redondas_elementos"
        android:backgroundTint="?attr/colorPrimary"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imageMateria"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_launcher_foreground"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvNombreMateria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre de la Materia"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción:"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDescripcionMateria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Descripción de la materia aquí."
            android:textColor="?attr/colorOnPrimary"
            android:textSize="14sp"
            android:gravity="start" />

        <ProgressBar
            android:id="@+id/progressBarMateria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            style="?android:attr/progressBarStyleHorizontal" />

        <TextView
            android:id="@+id/tvProgresoMateria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Progreso: 0%"
            android:textColor="@color/colorOnBackground"
            android:textSize="13sp"
            android:visibility="gone"
            android:gravity="center" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>