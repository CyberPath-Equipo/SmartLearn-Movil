<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical"
    android:animation="@anim/fade_in"
    tools:context=".ui.main.combo.principal.subtema.SubtemasFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_elevated"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvNombreTema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tema: ''Algún Tema''"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorTertiary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Subtemas Disponibles"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorTertiary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Desliza para explorar más subtemas"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorTertiary" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerSubtemas"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="36dp"
            android:paddingEnd="40dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_prev_subtema"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:contentDescription="Subtema anterior"
                android:src="@drawable/ic_arrow_back"
                app:backgroundTint="@color/colorAccent"
                app:fabSize="mini"
                app:tint="@android:color/white" />

            <LinearLayout
                android:id="@+id/indicadores_container_subtemas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_next_subtema"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:contentDescription="Subtema siguiente"
                android:src="@drawable/ic_arrow_forward"
                app:backgroundTint="@color/colorAccent"
                app:fabSize="mini"
                app:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_volver"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Volver"
        android:text="Volver"
        android:textAllCaps="false"
        android:elevation="4dp"
        app:backgroundTint="?attr/colorSecondary"
        app:cornerRadius="12dp" />

</LinearLayout>